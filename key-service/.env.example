# Database (shared with payment service)
DATABASE_URL=postgresql://platformpub:CHANGE_ME@localhost:5432/platformpub

# KMS — 32 bytes hex (64 chars). Generate with: openssl rand -hex 32
# In production, replace this with a real KMS (AWS KMS, GCP KMS, Vault)
KMS_MASTER_KEY_HEX=<64 hex chars>

# Nostr service keypair — same key used by the payment service for receipt signing
# Generate with: node -e "const {generateSecretKey}=require('nostr-tools'); console.log(Buffer.from(generateSecretKey()).toString('hex'))"
PLATFORM_SERVICE_PRIVKEY=<64 hex chars>

# Shared secret for internal service-to-service calls — the gateway sends it on
# every key-service request and this service requireEnv()s it at boot (index.ts),
# so it exits immediately without one. Must be the SAME value the gateway,
# key-custody and this service all hold; the gateway proves the match at boot
# (lib/internal-parity.ts) and exits on a definitive rejection.
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=<base64 secret>

# Server
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
