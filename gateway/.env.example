# Database (shared with payment and key services)
# When running in Docker, use 'postgres' as the host (Docker service name)
# When running directly on host, use 'localhost'
DATABASE_URL=postgresql://platformpub:CHANGE_ME@postgres:5432/platformpub

# Session — minimum 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=<at-least-32-characters>

# Cookie signing secret (falls back to SESSION_SECRET if unset)
COOKIE_SECRET=<at-least-32-characters>

# OAuth state HMAC key (falls back to SESSION_SECRET if unset)
OAUTH_STATE_SECRET=<at-least-32-characters>

# Platform service keypair — same key used by payment + key services
# Used by the gateway for NIP-44 unwrapping (deriving conversation keys)
PLATFORM_SERVICE_PRIVKEY=<64 hex chars>

# Reader hash key — used to HMAC reader pubkeys in receipt events
# Generate with: openssl rand -hex 32
READER_HASH_KEY=<64 hex chars>

# Admin — comma-separated account UUIDs that can access /admin/* routes
# At launch, this is the founder's account ID
ADMIN_ACCOUNT_IDS=<uuid1>,<uuid2>

# Email provider: 'postmark', 'resend', or 'console' (dev default)
EMAIL_PROVIDER=console
# EMAIL_FROM=login@all.haus
# POSTMARK_API_KEY=...
# RESEND_API_KEY=...

# Inbound email webhook secret for the Postmark inbound webhook.
# Generate with: openssl rand -hex 32
# HEX, NOT BASE64 — this value goes in the userinfo half of a URL, and base64's
# '/', '+' and '=' are URL syntax there. The failure is the unescaped-password
# shape: '/' and '#' make the URL unparseable, '@' and '%' parse but different
# parsers disagree about the value, so it presents as an authentication failure
# against a secret that is character-for-character correct.
# Configure Postmark's inbound URL with BASIC AUTH, not a path segment:
#   https://<user>:<this-value>@<your-api-host>/inbound-mail
# (the username is ignored — only the password half is the secret). A secret in
# a URL path is a secret in every request log; the old
# /inbound-mail/<this-value> form still works but is being retired.
# INBOUND_MAIL_SECRET=<64 hex characters>

# Stripe
STRIPE_SECRET_KEY=sk_test_...

# Internal service URLs
# When running in Docker, use service names (payment, keyservice, etc.)
# When running directly on host, use localhost
PAYMENT_SERVICE_URL=http://payment:3001
KEY_SERVICE_URL=http://keyservice:3002
BLOSSOM_URL=http://blossom:3003
KEY_CUSTODY_URL=http://key-custody:3004
PLATFORM_RELAY_WS_URL=ws://strfry:7777

# Internal service shared secret — must match key-custody's INTERNAL_SECRET
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=<base64 secret>

# Payment service token — must match payment-service's INTERNAL_SERVICE_TOKEN
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=<base64 secret>

# App URL — must be the FRONTEND URL (Next.js), not the gateway.
# Used for OAuth redirect URIs, Stripe redirects, CORS origin, and magic links.
# Dev: http://localhost:3010  |  Prod: https://all.haus
APP_URL=http://localhost:3010
# It is also what the ActivityPub instance actor is named after: the signing
# key's `keyId` is <APP_URL>/actor#main-key, and a remote instance fetches that
# URL to verify us. A localhost APP_URL therefore signs requests nothing on the
# internet can verify — which is correct for dev and worth knowing before
# wondering why a secure-mode instance still refuses.

# ActivityPub HTTP Signatures — the instance actor's private key.
# Base64 of a PKCS#8 PEM. Generate with:
#   npx tsx scripts/gen-ap-instance-key.ts
# UNSET means the platform reads the fediverse exactly as it did before signing
# existed: unsigned ActivityPub, with the Mastodon client-API fallback covering
# secure-mode Mastodon and nothing else (an Akkoma, Misskey, GoToSocial or
# hardened Lemmy instance in secure mode stays unreadable). SET AND MALFORMED
# kills the boot on purpose. feed-ingest needs the SAME value.
# AP_INSTANCE_PRIVATE_KEY_B64=<base64 of a PKCS#8 PEM>

# Server
PORT=3000
NODE_ENV=development

# POST /auth/dev-login — a FULL AUTHENTICATION BYPASS: any live member's email
# address returns that member's session cookie. Needs NODE_ENV != production AND
# this set to 1. NEVER set it in production; docker-compose.yml pins it to 0
# under the gateway's `environment:` block (which overrides this file), so a
# local stack arms it from the ROOT .env instead. See DEPLOYMENT.md.
# DEV_LOGIN_ENABLED=1
LOG_LEVEL=info

# Google OAuth (for "Sign in with Google")
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
