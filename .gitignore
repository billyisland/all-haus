node_modules/

# Environment files (contain secrets)
.env
gateway/.env
payment-service/.env
key-service/.env
key-custody/.env
web/.env

# Build output
*/dist/
web/.next/
*.tsbuildinfo
web/next-env.d.ts

# Compiled shared module outputs (source .ts files are canonical)
shared/src/**/*.js
shared/src/**/*.js.map
shared/src/**/*.d.ts
shared/src/**/*.d.ts.map

*.log

# Claude Code harness state — churns every session, never meaningful to track (§0f-18)
.claude/scheduled_tasks.lock

# Inbound patch bundles — review their contents, never commit the archive
# (a zip dodges every tripwire; the 2026-07-27 landing bundle carried a
# hairline and real names in a form check-hairlines.sh cannot scan)
*.zip

# Segregation probe output — a run artifact, overwritten on every run.
# The findings that matter live in FUNDS-SEGREGATION-INTEGRATION.md §5.
segregation-probe-results.json
segregation-sequence-results.json
# --out <file> renames the run's output, so the default name alone is not enough.
# Both spellings, because both have been used: `seq-` for the sequence steps and
# `seg-` for the 2026-08-01 batch and the --brands matrix. These carry sandbox
# customer/account/charge ids and are regenerated by any re-run; the findings
# that matter are written up in the ADR and FIX-PROGRAMME.
seq-*.json
seg-*.json

# The prose tree — a plain-English mirror of this source, one page per file,
# generated in ~3s by prose-tool. That tool lives OUTSIDE this repo (~/prose-tool,
# its own git), so this line is the only trace it leaves here. The tree is derived
# from nothing but the tool's lexicon and its header cache, both versioned there;
# committing it would put ~9 MB of machine-written text into every diff for no
# fact this repo doesn't already hold. Ignored here rather than in
# .git/info/exclude so the guard survives a fresh clone.
prose/
# …and any throwaway rebuild beside it. The golden-master check builds to a
# SECOND tree and diffs it against prose/ (prose-tool REVIEW P4.2), and those
# trees are 12 MB each: a run named prose-gm3/ slipped straight past the line
# above and 10,088 generated files went into a docs commit, because untracked
# files do not show in `git diff --stat` and `git add -A` takes them anyway.
prose-*/

# Local dev compose override (session-scoped port publishing; never committed)
docker-compose.override.yml
certs/

# LibreOffice/OpenOffice lock files (a doc open in an editor)
.~lock.*#
