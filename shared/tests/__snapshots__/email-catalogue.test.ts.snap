exports[`the email catalogue > renders chargeback 1`] = `
{
  "htmlBody": "<style>
@font-face { font-family: 'Jost'; font-style: normal; font-weight: 400 600; src: url('https://all.haus/fonts/jost-latin.woff2') format('woff2'); }
@font-face { font-family: 'Literata'; font-style: normal; font-weight: 300 700; src: url('https://all.haus/fonts/literata-latin-400.woff2') format('woff2'); }
@font-face { font-family: 'Literata'; font-style: italic; font-weight: 300 700; src: url('https://all.haus/fonts/literata-latin-400-italic.woff2') format('woff2'); }
@font-face { font-family: 'IBM Plex Mono'; font-style: normal; font-weight: 400; src: url('https://all.haus/fonts/ibm-plex-mono-latin-400.woff2') format('woff2'); }
</style>
<div style="background: #f0efeb; padding: 32px 16px;">
<div style="max-width: 560px; margin: 0 auto;">
<div style="margin: 0 0 20px; font-family: Jost, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 22px; font-weight: 500; letter-spacing: -0.01em; line-height: 28px; color: #111111;"><a href="https://all.haus" style="color: #111111; text-decoration: none;"><img src="https://all.haus/brand/allhaus-disc-on-bone-1024.png" alt="" width="28" height="28" style="vertical-align: middle; margin-right: 10px; border: 0;" /><span style="vertical-align: middle;">all.haus</span></a></div>
<div style="background: #ffffff; padding: 32px 28px;">
<h2 style="font-family: Literata, Georgia, 'Times New Roman', serif; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; color: #111111; margin: 0 0 20px;">A payment has been reversed</h2>
<p style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: 0.01em; color: #5f5e5a; line-height: 1.65; margin: 0 0 16px;">Vita, a reader&#39;s bank has clawed back a payment that included your writing, and £2.76 has come out of your earnings.</p>
<p style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: 0.01em; color: #5f5e5a; line-height: 1.65; margin: 0 0 16px;">The pieces it covered:</p>
<ul style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: 0.01em; color: #5f5e5a; line-height: 1.65; margin: 0 0 16px; padding-left: 20px;"><li>The Edwardians</li><li>The Lighthouse Keepers</li></ul>
<p style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: 0.01em; color: #5f5e5a; line-height: 1.65; margin: 0 0 16px;">The decision was the bank&#39;s, not ours, and we cannot undo it alone. If you have anything that shows the reading was genuine — correspondence with the reader, say, or how they came to your work — send it to <a href="mailto:support@all.haus" style="color: #111111; text-decoration: underline;">support@all.haus</a> and we will put it to the card network.</p>
<p style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 15px; letter-spacing: 0.01em; color: #5f5e5a; line-height: 1.65; margin: 0 0 16px;">Your earnings: <a href="https://all.haus/account" style="color: #111111; text-decoration: underline;">https://all.haus/account</a>.</p>
</div>
<p style="font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: #8a8880; margin: 20px 0 0;">all.haus: together we can make it</p>
</div>
</div>",
  "subject": "A reader has disputed a payment for your writing",
  "textBody": "A payment has been reversed

Vita, a reader's bank has clawed back a payment that included your writing, and £2.76 has come out of your earnings.

The pieces it covered:

  - The Edwardians
  - The Lighthouse Keepers

The decision was the bank's, not ours, and we cannot undo it alone. If you have anything that shows the reading was genuine — correspondence with the reader, say, or how they came to your work — send it to support@all.haus and we will put it to the card network.

Your earnings: https://all.haus/account.

—
all.haus: together we can make it",
}
`;

exports[`the email catalogue > renders email-change 1`] = `
{
