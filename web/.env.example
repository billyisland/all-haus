# Gateway URL — server-side only (used by Next.js SSR to proxy API requests)
# In Docker: use the Docker service name. On host: use localhost.
GATEWAY_URL=http://gateway:3000

# Public env vars (available to the browser via NEXT_PUBLIC_ prefix). They
# resolve in the user's browser, not inside Docker.
#
# There is no browser-side gateway URL: every browser call is same-origin
# through the Next.js /api rewrite to GATEWAY_URL above, via lib/api/client's
# one base. (NEXT_PUBLIC_GATEWAY_URL was retired with its last reader, CA-J2.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
