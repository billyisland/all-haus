# Database (shared with all services)
DATABASE_URL=postgresql://platformpub:CHANGE_ME@localhost:5432/platformpub

# Account keypair encryption key — 32 bytes hex (64 chars)
# This key encrypts user Nostr private keys at rest.
# It must NOT be shared with the gateway or any other service.
# Generate with: openssl rand -hex 32
ACCOUNT_KEY_HEX=<64 hex chars>

# Platform service PUBLIC key — the counterparty when unwrapping NIP-44 content
# keys for readers. Must be the public half of key-service's
# PLATFORM_SERVICE_PRIVKEY. This service needs only the public half; a legacy
# PLATFORM_SERVICE_PRIVKEY here still works (the pubkey is derived and the boot
# log prints the value to set instead).
PLATFORM_SERVICE_PUBKEY=<64 hex chars>

# Internal service secret. Callers send it in X-Internal-Secret AND use it to
# mint the per-request binding every key route now also requires
# (X-Internal-Binding — shared/src/lib/internal-binding.ts). Must match the
# gateway's value exactly.
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=<base64 secret>

# Server
PORT=3004
NODE_ENV=development
LOG_LEVEL=info
